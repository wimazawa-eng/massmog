                            TextColor3 = Colors.Accent,

                            TextSize = 10,

                            Font = Enum.Font.GothamBold,

                            TextXAlignment = Enum.TextXAlignment.Right,

                            Parent = frame,

                        })



                        local sliderBg = Create("Frame", {

                            Size = UDim2.new(1, 0, 0, 4),

                            Position = UDim2.new(0, 0, 0, 22),

                            BackgroundColor3 = Colors.Slider,

                            BorderSizePixel = 0,

                            Parent = frame,

                        })

                        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = sliderBg})



                        local initPerc = math.clamp((Slider.Value - min) / (max - min), 0, 1)



                        local sliderFill = Create("Frame", {

                            Size = UDim2.new(initPerc, 0, 1, 0),

                            BackgroundColor3 = Colors.Accent,

                            BorderSizePixel = 0,

                            Parent = sliderBg,

                        })

                        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = sliderFill})



                        local sliderKnob = Create("Frame", {

                            Size = UDim2.new(0, 12, 0, 12),

                            Position = UDim2.new(initPerc, 0, 0, 24),

                            AnchorPoint = Vector2.new(0.5, 0.5),

                            BackgroundColor3 = Colors.Text,

                            BorderSizePixel = 0,

                            ZIndex = 2,

                            Parent = frame,

                        })

                        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = sliderKnob})



                        local sliderBtn = Create("TextButton", {

                            Size = UDim2.new(1, 0, 1, 12),

                            Position = UDim2.new(0, 0, 0, -6),

                            BackgroundTransparency = 1,

                            Text = "",

                            ZIndex = 3,

                            Parent = sliderBg,

                        })



                        local sliding = false



                        local function applyValue(val)

                            Slider.Value = val

                            local p = math.clamp((val - min) / (max - min), 0, 1)

                            sliderFill.Size = UDim2.new(p, 0, 1, 0)

                            local trackWidth = sliderBg.AbsoluteSize.X

                            if trackWidth > 0 then

                                sliderKnob.Position = UDim2.new(0, p * trackWidth, 0, 24)

                            end

                            valLabel.Text = tostring(Round(val, decimals))

                        end



                        local function updateFromInput(inputX)

                            local rel = math.clamp((inputX - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)

                            local raw = min + rel * (max - min)

                            local stepped = math.floor(raw / increment + 0.5) * increment

                            stepped = math.clamp(stepped, min, max)

                            applyValue(stepped)

                            callback(Slider.Value)

                        end



                        sliderBtn.InputBegan:Connect(function(input)

                            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then

                                sliding = true

                                updateFromInput(input.Position.X)

                                local sink = input:GetGameProcessed() == false and input.UserInputType == Enum.UserInputType.Touch

                                if sink then

                                    pcall(function() input:Capture() end)

                                end

                            end

                        end)



                        UserInputService.InputChanged:Connect(function(input)

                            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then

                                updateFromInput(input.Position.X)

                            end

                        end)



                        UserInputService.InputEnded:Connect(function(input)

                            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then

                                sliding = false

                            end

                        end)



                        function Slider:Set(v)

                            v = math.clamp(v, min, max)

                            applyValue(v)

                            callback(v)

                        end

                        function Slider:Get() return Slider.Value end

                        

                        task.defer(function()

                            task.wait()

                            applyValue(Slider.Value)

                        end)

                        

                        Slider._name = text
                        Slider._frame = frame
                        Window.Elements[text] = Slider

                        table.insert(Section.Elements, Slider)

                        return Slider

                    end



