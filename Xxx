    local function DoSearch(query)
        query = query:lower()
        for _, sec in ipairs(Window.AllSections) do
            local secVisible = false
            for _, elem in ipairs(sec.Elements) do
                if elem._frame then
                    local match = query == "" or (elem._name and elem._name:lower():find(query, 1, true))
                    elem._frame.Visible = match
                    if match then secVisible = true end
                end
            end
            if sec._frame then
                sec._frame.Visible = query == "" or secVisible
            end
        end
    end

