                                    ColorPicker.S = math.clamp(rel.X / satVal.AbsoluteSize.X, 0, 1)

                                    ColorPicker.V = math.clamp(1 - rel.Y / satVal.AbsoluteSize.Y, 0, 1)

                                    updateColor()

                                elseif hueDragging then

                                    ColorPicker.H = math.clamp((input.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)

                                    updateColor()

                                elseif alphaDragging then

                                    local rel = math.clamp((input.Position.Y - alphaBar.AbsolutePosition.Y) / alphaBar.AbsoluteSize.Y, 0, 1)

                                    ColorPicker.V = 1 - rel

                                    updateColor()

                                end

                            end

                        end)



                        UserInputService.InputEnded:Connect(function(input)

                            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then

                                svDragging, hueDragging, alphaDragging = false, false, false

                            end

                        end)



                        local function positionPopup()

                            local pabs = preview.AbsolutePosition

                            local psz = preview.AbsoluteSize

                            popup.Position = UDim2.new(0, pabs.X - 150, 0, pabs.Y + psz.Y + 4)

                        end



                        hexInput.FocusLost:Connect(function()

                            local txt = hexInput.Text:gsub("#", "")

                            local ok, col = pcall(function() return Color3.fromHex(txt) end)

                            if ok and col then

                                ColorPicker.Value = col

                                ColorPicker.H, ColorPicker.S, ColorPicker.V = col:ToHSV()

                                updateColor()

                            else

                                hexInput.Text = "#" .. ColorPicker.Value:ToHex()

                            end

                        end)



                        preview.MouseButton1Click:Connect(function()

                            if ActiveDropdown then

                                -- Collapse inline dropdown

                                Tween(ActiveDropdown._list, {Size = UDim2.new(1, 0, 0, 0)}, 0.15)

                                if ActiveDropdown._wrapper then

                                    TweenCallback(ActiveDropdown._wrapper, {Size = UDim2.new(1, 0, 0, 46)}, 0.15, function()

                                        ActiveDropdown._list.Visible = false

                                    end)

                                else

                                    ActiveDropdown._list.Visible = false

                                end

                                Tween(ActiveDropdown._arrow, {Rotation = 0}, 0.12)

                                ActiveDropdown.Open = false

                                ActiveDropdown = nil

                            end

                            if ActiveColorPicker and ActiveColorPicker ~= ColorPicker then

                                ActiveColorPicker._popup.Visible = false

                                ActiveColorPicker.Open = false

                                ActiveColorPicker = nil

                            end

                            ColorPicker.Open = not ColorPicker.Open

                            if ColorPicker.Open then

                                positionPopup()

                                popup.Visible = true

                                ActiveColorPicker = ColorPicker

                            else

                                popup.Visible = false

                                ActiveColorPicker = nil

                            end

                        end)



                        function ColorPicker:Set(col)

                            ColorPicker.Value = col

                            ColorPicker.H, ColorPicker.S, ColorPicker.V = col:ToHSV()

                            updateColor()

                        end

                        function ColorPicker:Get() return ColorPicker.Value end

                        ColorPicker._name = text
                        ColorPicker._frame = frame
                        Window.Elements[text] = ColorPicker

                        table.insert(Section.Elements, ColorPicker)

                        return ColorPicker

                    end



                    table.insert(SubTab.Sections, Section)

                    return Section

                end



                table.insert(Tab.SubTabs, SubTab)

                return SubTab

            end



            table.insert(Category.Tabs, Tab)

            table.insert(Window.Tabs, Tab)

            return Tab

        end



        return Category

    end



    -- Renamed from Config to Stuff with subtabs

    local SettingsCat = Window:AddCategory("SETTINGS")

    local StuffTab = SettingsCat:AddTab("Stuff")

    

    -- Config subtab (renamed from Main)

    local ConfigSubTab = StuffTab:AddSubTab("Config")

    local ConfigSection = ConfigSubTab:AddSection("Configuration", 1)



    configListFrame = Create("ScrollingFrame", {

        Size = UDim2.new(1, 0, 0, 90),

        BackgroundColor3 = Colors.Element,

        BackgroundTransparency = 0.5,

        BorderSizePixel = 0,

        ScrollBarThickness = 2,

        ScrollBarImageColor3 = Colors.Accent,

        CanvasSize = UDim2.new(0, 0, 0, 0),

        AutomaticCanvasSize = Enum.AutomaticSize.Y,

        Parent = ConfigSection.Content,

    })

    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = configListFrame})

    Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3), Parent = configListFrame})

    Create("UIPadding", {

        PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3),

        PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3),

        Parent = configListFrame,

    })



    local ConfigNameInput = ConfigSection:AddTextBox("Config Name", "", function() end)



    ConfigSection:AddToggle("Auto Load Config", false, function(v)

        ConfigData.AutoLoad = v

        if v and ConfigData.SelectedConfig then

            LoadConfig(ConfigData.SelectedConfig)

        end

    end)



    local ConfigActionSection = ConfigSubTab:AddSection("Actions", 2)

    ConfigActionSection:AddButton("Save Config", function()

        local name = ConfigNameInput:Get()

        if name ~= "" then SaveConfig(name) RefreshConfigList() end

    end)

    ConfigActionSection:AddButton("Load Config", function()

        if ConfigData.SelectedConfig then LoadConfig(ConfigData.SelectedConfig) end

    end)

    ConfigActionSection:AddButton("Delete Config", function()

        if ConfigData.SelectedConfig then DeleteConfig(ConfigData.SelectedConfig) RefreshConfigList() end

    end)

    ConfigActionSection:AddButton("Refresh List", function()

        RefreshConfigList()

    end)



    -- Colors subtab

    local ColorsSubTab = StuffTab:AddSubTab("Colors")

    local ColorsSection = ColorsSubTab:AddSection("Theme Colors", 1)



    ColorsSection:AddColorPicker("Accent Color", Color3.fromRGB(110, 72, 200), function(v)

        UpdateAccentColor(v)

    end)



    ColorsSection:AddColorPicker("Background", Colors.Background, function(v)

        Colors.Background = v

        Main.BackgroundColor3 = v

    end)



    ColorsSection:AddColorPicker("Sidebar", Colors.Sidebar, function(v)

        Colors.Sidebar = v

        Sidebar.BackgroundColor3 = v

    end)



    ColorsSection:AddColorPicker("Content Area", Colors.Content, function(v)

        Colors.Content = v

        ContentArea.BackgroundColor3 = v

    end)



    ColorsSection:AddColorPicker("Section Background", Colors.Section, function(v)

        Colors.Section = v

    end)



    ColorsSection:AddColorPicker("Text Color", Colors.Text, function(v)

        Colors.Text = v

        TitleLabel.TextColor3 = v

    end)



    -- Keybinds subtab

    local KeybindsSubTab = StuffTab:AddSubTab("Keybinds")

    local UIKeybindsSection = KeybindsSubTab:AddSection("UI Keybinds", 1)



    -- UI Toggle Keybind

    local UIToggleKeybind = {Value = UIToggleKey, Listening = false}

    

    local uiBindFrame = Create("Frame", {

        Size = UDim2.new(1, 0, 0, 24),

        BackgroundTransparency = 1,

        Parent = UIKeybindsSection.Content,

    })



    Create("TextLabel", {

        Size = UDim2.new(1, -58, 1, 0),

        BackgroundTransparency = 1,

        Text = "UI Bind",

        TextColor3 = Colors.TextMid,

        TextSize = 10,

        Font = Enum.Font.Gotham,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = uiBindFrame,

    })



    local uiKeyBtn = Create("TextButton", {

        Size = UDim2.new(0, 52, 0, 19),

        Position = UDim2.new(1, -52, 0.5, 0),

        AnchorPoint = Vector2.new(0, 0.5),

        BackgroundColor3 = Colors.Element,

        BorderSizePixel = 0,

        Text = UIToggleKey.Name,

        TextColor3 = Colors.Text,

        TextSize = 9,

        Font = Enum.Font.Gotham,

        AutoButtonColor = false,

        Parent = uiBindFrame,

    })

    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = uiKeyBtn})



    uiKeyBtn.MouseEnter:Connect(function() Tween(uiKeyBtn, {BackgroundColor3 = Colors.ElementHover}, 0.1) end)

    uiKeyBtn.MouseLeave:Connect(function() 

        if not UIToggleKeybind.Listening then Tween(uiKeyBtn, {BackgroundColor3 = Colors.Element}, 0.1) end

    end)



    uiKeyBtn.MouseButton1Click:Connect(function()

        UIToggleKeybind.Listening = true

        uiKeyBtn.Text = "..."

        Tween(uiKeyBtn, {BackgroundColor3 = Colors.Accent}, 0.1)

    end)



    UserInputService.InputBegan:Connect(function(input, gpe)

        if UIToggleKeybind.Listening then

            if input.UserInputType == Enum.UserInputType.Keyboard then

                UIToggleKey = input.KeyCode

                UIToggleKeybind.Value = input.KeyCode

                uiKeyBtn.Text = input.KeyCode.Name

                UIToggleKeybind.Listening = false

                Tween(uiKeyBtn, {BackgroundColor3 = Colors.Element}, 0.1)

            end

        end

    end)



    -- All Keybinds List Section

    local AllKeybindsSection = KeybindsSubTab:AddSection("All Keybinds", 2)



    keybindListFrame = Create("ScrollingFrame", {

        Size = UDim2.new(1, 0, 0, 200),

        BackgroundColor3 = Colors.Element,

        BackgroundTransparency = 0.5,

        BorderSizePixel = 0,

        ScrollBarThickness = 2,

        ScrollBarImageColor3 = Colors.Accent,

        CanvasSize = UDim2.new(0, 0, 0, 0),

        AutomaticCanvasSize = Enum.AutomaticSize.Y,

        Parent = AllKeybindsSection.Content,

    })

    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = keybindListFrame})

    Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = keybindListFrame})

    Create("UIPadding", {

        PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),

        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),

        Parent = keybindListFrame,

    })



    function Window:Destroy()

        ScreenGui:Destroy()

    end



    RefreshConfigList()

    

    -- Delay keybind list refresh to allow all keybinds to be registered

    task.defer(function()

        task.wait(0.1)

        RefreshKeybindList()

    end)



    if #Window.Tabs > 0 then

        Window.Tabs[1]:Select()

    end



    return Window

end

return Library
