                local lsz = dp._list.AbsoluteSize

                local inList = mx >= labs.X and mx <= labs.X + lsz.X and my >= labs.Y and my <= labs.Y + lsz.Y

                if not inBtn and not inList then

                    -- Collapse inline dropdown

                    Tween(dp._list, {Size = UDim2.new(1, 0, 0, 0)}, 0.15)

                    if dp._wrapper then

                        TweenCallback(dp._wrapper, {Size = UDim2.new(1, 0, 0, 46)}, 0.15, function()

