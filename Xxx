                        end)

                    else

                        dp._list.Visible = false

                    end

                    Tween(dp._arrow, {Rotation = 0}, 0.12)

                    dp.Open = false

                    ActiveDropdown = nil

                end

            end

            if ActiveColorPicker then

                local cp = ActiveColorPicker

                local pabs = cp._preview.AbsolutePosition

                local psz = cp._preview.AbsoluteSize

                local ppabs = cp._popup.AbsolutePosition

                local ppsz = cp._popup.AbsoluteSize

                local mx, my = input.Position.X, input.Position.Y

                local inPrev = mx >= pabs.X and mx <= pabs.X + psz.X and my >= pabs.Y and my <= pabs.Y + psz.Y

                local inPop = mx >= ppabs.X and mx <= ppabs.X + ppsz.X and my >= ppabs.Y and my <= ppabs.Y + ppsz.Y

                if not inPrev and not inPop then

                    cp._popup.Visible = false

                    cp.Open = false

                    ActiveColorPicker = nil

                end

            end

        end

    end)



