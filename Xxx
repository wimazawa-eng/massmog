                            for _, c in pairs(dropScroll:GetChildren()) do

                                if c:IsA("TextButton") then c:Destroy() end

                            end

                            optionButtons = {}

                            

                            for _, opt in ipairs(Dropdown.Options) do

                                local isSelected = multi and Dropdown.Value[opt] or Dropdown.Value == opt

                                local optBtn = Create("TextButton", {

                                    Size = UDim2.new(1, 0, 0, 28),

                                    BackgroundColor3 = isSelected and Colors.DropdownSelected or Colors.Element,

                                    BackgroundTransparency = 0,

                                    BorderSizePixel = 0,

                                    Text = "",

                                    AutoButtonColor = false,

                                    ZIndex = 13,

                                    Parent = dropScroll,

                                })

                                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = optBtn})

                                

                                -- Text label for better control

                                local optText = Create("TextLabel", {

                                    Size = UDim2.new(1, -12, 1, 0),

                                    Position = UDim2.new(0, 8, 0, 0),

                                    BackgroundTransparency = 1,

                                    Text = opt,

                                    TextColor3 = isSelected and Colors.Text or Colors.TextMid,

                                    TextSize = 10,

                                    Font = isSelected and Enum.Font.GothamBold or Enum.Font.Gotham,

                                    TextXAlignment = Enum.TextXAlignment.Left,

                                    ZIndex = 14,

                                    Parent = optBtn,

                                })

                                

                                -- Add selection indicator

                                if isSelected then

                                    local indicator = Create("Frame", {

                                        Size = UDim2.new(0, 3, 0.6, 0),

                                        Position = UDim2.new(0, 0, 0.2, 0),

                                        BackgroundColor3 = Colors.Accent,

                                        BorderSizePixel = 0,

                                        ZIndex = 15,

                                        Parent = optBtn,

                                    })

                                    Create("UICorner", {CornerRadius = UDim.new(0, 2), Parent = indicator})

                                end



                                optionButtons[opt] = optBtn



                                optBtn.MouseEnter:Connect(function()

                                    local sel = multi and Dropdown.Value[opt] or Dropdown.Value == opt

                                    if not sel then

                                        Tween(optBtn, {BackgroundColor3 = Colors.DropdownHover}, 0.1)

                                        Tween(optText, {TextColor3 = Colors.Text}, 0.1)

                                    end

                                end)

                                optBtn.MouseLeave:Connect(function()

                                    local sel = multi and Dropdown.Value[opt] or Dropdown.Value == opt

                                    if not sel then

                                        Tween(optBtn, {BackgroundColor3 = Colors.Element}, 0.1)

                                        Tween(optText, {TextColor3 = Colors.TextMid}, 0.1)

                                    end

                                end)

                                optBtn.MouseButton1Click:Connect(function()

                                    if multi then

                                        Dropdown.Value[opt] = not Dropdown.Value[opt]

                                        refreshOptions()

                                        dropText.Text = getDisplayText()

                                        callback(Dropdown.Value)

                                    else

                                        Dropdown.Value = opt

                                        dropText.Text = opt

                                        Dropdown.Open = false

                                        Tween(dropArrow, {Rotation = 0}, 0.12)

                                        -- Collapse inline

                                        Tween(dropList, {Size = UDim2.new(1, 0, 0, 0)}, 0.15)

                                        TweenCallback(wrapper, {Size = UDim2.new(1, 0, 0, wrapperClosedHeight)}, 0.15, function()

                                            dropList.Visible = false

                                        end)

                                        if ActiveDropdown == Dropdown then ActiveDropdown = nil end

                                        refreshOptions() -- Refresh to update highlight

                                        callback(Dropdown.Value)

                                    end

                                end)

                            end

                        end



                        refreshOptions()

                        dropText.Text = getDisplayText()



                        dropBtn.MouseEnter:Connect(function()

                            Tween(dropBtn, {BackgroundColor3 = Colors.ElementHover}, 0.1)

                        end)

                        dropBtn.MouseLeave:Connect(function()

                            Tween(dropBtn, {BackgroundColor3 = Colors.Element}, 0.1)

                        end)



                        -- Calculate list height

                        local function getListHeight()

                            return math.min(#Dropdown.Options * 31 + 12, 160)

                        end

                        

                        -- Expand/collapse the wrapper and list with animation

                        local function expandDropdown()

                            local listH = getListHeight()

                            dropList.Visible = true

                            dropList.Size = UDim2.new(1, 0, 0, 0)

                            -- Animate list expanding

                            Tween(dropList, {Size = UDim2.new(1, 0, 0, listH)}, 0.2)

                            -- Expand wrapper to fit

                            Tween(wrapper, {Size = UDim2.new(1, 0, 0, wrapperClosedHeight + listH + 4)}, 0.2)

                        end

                        

                        local function collapseDropdown()

                            -- Animate list collapsing

                            Tween(dropList, {Size = UDim2.new(1, 0, 0, 0)}, 0.15)

                            -- Collapse wrapper back

                            TweenCallback(wrapper, {Size = UDim2.new(1, 0, 0, wrapperClosedHeight)}, 0.15, function()

                                dropList.Visible = false

                            end)

                        end

                        

                        dropBtn.MouseButton1Click:Connect(function()

                            if ActiveDropdown and ActiveDropdown ~= Dropdown then

                                -- Close other dropdown

                                ActiveDropdown._list.Visible = false

                                Tween(ActiveDropdown._arrow, {Rotation = 0}, 0.12)

                                ActiveDropdown.Open = false

                                -- Collapse other wrapper

                                if ActiveDropdown._wrapper then

                                    Tween(ActiveDropdown._wrapper, {Size = UDim2.new(1, 0, 0, 46)}, 0.15)

                                end

                                ActiveDropdown = nil

                            end

                            if ActiveColorPicker then

                                ActiveColorPicker._popup.Visible = false

                                ActiveColorPicker.Open = false

                                ActiveColorPicker = nil

                            end

                            Dropdown.Open = not Dropdown.Open

                            if Dropdown.Open then

                                expandDropdown()

                                Tween(dropArrow, {Rotation = 180}, 0.15)

                                ActiveDropdown = Dropdown

                            else

                                collapseDropdown()

                                Tween(dropArrow, {Rotation = 0}, 0.15)

                                ActiveDropdown = nil

                            end

                        end)

                        

                        Dropdown._wrapper = wrapper
                        Dropdown._name = text
                        Dropdown._frame = wrapper



                        function Dropdown:Set(v)

                            if multi then

                                Dropdown.Value = {}

                                for _, opt in pairs(v) do Dropdown.Value[opt] = true end

                            else

                                Dropdown.Value = v

                            end

                            dropText.Text = getDisplayText()

                            refreshOptions()

                            callback(Dropdown.Value)

                        end

                        function Dropdown:Get() return Dropdown.Value end

                        function Dropdown:Refresh(opts)

                            Dropdown.Options = opts

                            refreshOptions()

                        end



                        Window.Elements[text] = Dropdown

                        table.insert(Section.Elements, Dropdown)

                        return Dropdown

                    end



