    local function SaveConfig(name)

        if name == "" then return end

        local data = {}

        for key, elem in pairs(Window.Elements) do

            if elem.Get then

                local val = elem:Get()

                if typeof(val) == "Color3" then

                    data[key] = {t = "c", r = val.R, g = val.G, b = val.B}

                elseif typeof(val) == "EnumItem" then

                    data[key] = {t = "e", n = val.Name}

                elseif typeof(val) == "table" then

                    data[key] = {t = "tbl", d = val}

                else

                    data[key] = {t = "v", d = val}

                end

            end

        end

        ConfigData.Configs[name] = data

        if writefile and isfolder then

            if not isfolder("UILibConfigs") then makefolder("UILibConfigs") end

            writefile("UILibConfigs/" .. name .. ".json", HttpService:JSONEncode(data))

        end

    end



    local function LoadConfig(name)

        if name == "" then return end

        local data = ConfigData.Configs[name]

        if not data and readfile and isfile then

            if isfile("UILibConfigs/" .. name .. ".json") then

                data = HttpService:JSONDecode(readfile("UILibConfigs/" .. name .. ".json"))

                ConfigData.Configs[name] = data

            end

        end

        if not data then return end

        for key, saved in pairs(data) do

            local elem = Window.Elements[key]

            if elem and elem.Set then

                if saved.t == "c" then

                    elem:Set(Color3.new(saved.r, saved.g, saved.b))

                elseif saved.t == "e" then

                    pcall(function() elem:Set(Enum.KeyCode[saved.n]) end)

                elseif saved.t == "tbl" then

                    elem:Set(saved.d)

                else

                    elem:Set(saved.d)

                end

            end

        end

    end



    local function DeleteConfig(name)

        if name == "" then return end

        ConfigData.Configs[name] = nil

        if delfile and isfile and isfile("UILibConfigs/" .. name .. ".json") then

            delfile("UILibConfigs/" .. name .. ".json")

        end

        if ConfigData.SelectedConfig == name then ConfigData.SelectedConfig = nil end

    end



